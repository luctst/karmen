# Karmen environment config. Copy to .env and fill in real values.

# Database (PG* vars are source of truth; compose assembles DATABASE_URL from them)
PGUSER=karmen
PGPASSWORD=change-me-in-.env
PGDATABASE=karmen

# Port mappings
WEB_PORT=8080
WEB_DEV_PORT=5173
API_PORT=3000
DB_PORT=5432

# App config
VITE_API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8080
