# Karmen — environment configuration template.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored (never committed). docker compose reads it automatically.

# ─── Database (discrete PG* vars are the SOURCE OF TRUTH) ───
# Postgres is configured from these, and compose assembles DATABASE_URL from
# them for Prisma: postgres://PGUSER:PGPASSWORD@db:5432/PGDATABASE?schema=public
PGUSER=karmen
# REQUIRED — compose will refuse to start without it. Use a strong value.
PGPASSWORD=change-me-in-.env
PGDATABASE=karmen
# PGHOST/PGPORT are fixed to db:5432 inside the compose network and set there.

# ─── Host port mappings ─────────────────────────────────────
# Web (vite preview) published on the host:
WEB_PORT=8080
# Web (vite dev server, HMR) — used by docker-compose.override.yml:
WEB_DEV_PORT=5173
# API published on the host (the SPA calls this origin):
API_PORT=3000
# Postgres is internal-only by default (not published). Set this and add a
# "127.0.0.1:${DB_PORT}:5432" mapping in docker-compose.override.yml if you
# want to reach it from a host SQL client:
DB_PORT=5432

# ─── App config ─────────────────────────────────────────────
# Web build-time API base URL. Separate origin (no reverse proxy) -> point at
# the API's published host origin.
VITE_API_BASE_URL=http://localhost:3000
# API CORS allow-origin (the web app's origin). The API must honor this.
CORS_ORIGIN=http://localhost:8080
